{
  "name": "@datascope/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm build && node --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:integration": "tsc -p tsconfig.test.json && node --env-file-if-exists=../../.env --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand"
  },
  "dependencies": {
    "@datascope/contracts": "workspace:*",
    "@datascope/db": "workspace:*",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@types/jest": "30.0.0",
    "@types/supertest": "7.2.1",
    "jest": "30.2.0",
    "supertest": "7.1.4"
  }
}
