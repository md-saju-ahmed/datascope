{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist/test",
    "types": ["node", "jest"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "declaration": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/store/**/*.ts",
    "test/*.unit.spec.ts",
    "test/api.runtime.spec.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
