# Copy privately to .env.production; never use these placeholders as credentials.
# Generate each password independently, e.g. openssl rand -hex 32 (URL-safe hex).
APP_ORIGIN=https://datascope.example.com
PROD_POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_INDEPENDENT_RANDOM_HEX
PROD_APP_DB_PASSWORD=REPLACE_WITH_INDEPENDENT_RANDOM_HEX
API_IMAGE=datascope-api:REPLACE_WITH_COMMIT_SHA
WEB_IMAGE=datascope-web:REPLACE_WITH_COMMIT_SHA
TLS_DIR=/srv/datascope/tls
BACKUP_DIR=/srv/datascope/backups
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# One-shot migration operations only; owner approval is still required.
DATASCOPE_MIGRATION_APPROVED=false
