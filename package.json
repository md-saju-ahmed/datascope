{
  "name": "datascope",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev:api": "pnpm --filter @datascope/api dev",
    "dev:web": "pnpm --filter @datascope/web dev",
    "test:web": "pnpm --filter @datascope/api test && pnpm --filter @datascope/web test:e2e",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:api": "node scripts/smoke-api.mjs",
    "env:init": "node scripts/init-local-env.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:test:up": "docker compose --profile test up -d --wait postgres_test",
    "db:extensions": "node --env-file-if-exists=.env scripts/install-local-extensions.mjs",
    "db:extensions:test": "node --env-file-if-exists=.env scripts/install-local-extensions.mjs --test",
    "db:explain": "node --env-file-if-exists=.env scripts/explain-local-search.mjs",
    "test:integration": "turbo run test:integration",
    "smoke:db": "node scripts/smoke-api.mjs --ready",
    "benchmark:backend": "node --env-file-if-exists=.env scripts/benchmark-backend.mjs",
    "docs:api": "node scripts/generate-openapi.mjs",
    "verify:backend": "pnpm build && pnpm lint && pnpm typecheck && pnpm format:check && pnpm test && pnpm test:integration && pnpm smoke:db && pnpm docs:api",
    "verify:ci": "node scripts/verify-ci.mjs",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "deploy:neon": "node scripts/deploy-neon.mjs",
    "db:generate": "pnpm --filter @datascope/db db:generate",
    "db:check": "pnpm --filter @datascope/db db:check",
    "db:migrate": "pnpm --filter @datascope/db db:migrate",
    "db:migrate:test": "pnpm --filter @datascope/db db:migrate:test",
    "seed:env:init": "node scripts/init-seed-env.mjs",
    "db:seed": "pnpm --filter @datascope/db db:seed",
    "db:seed:test": "pnpm --filter @datascope/db db:seed:test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "eslint": "10.0.0",
    "prettier": "3.6.2",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
