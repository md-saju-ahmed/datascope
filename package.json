{
  "name": "datascope",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev:api": "pnpm --filter @datascope/api dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:api": "node scripts/smoke-api.mjs",
    "env:init": "node scripts/init-local-env.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:test:up": "docker compose --profile test up -d --wait postgres_test",
    "test:integration": "turbo run test:integration",
    "smoke:db": "node scripts/smoke-api.mjs --ready",
    "db:generate": "pnpm --filter @datascope/db db:generate",
    "db:check": "pnpm --filter @datascope/db db:check",
    "db:migrate": "pnpm --filter @datascope/db db:migrate",
    "db:migrate:test": "pnpm --filter @datascope/db db:migrate:test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "eslint": "10.0.0",
    "prettier": "3.6.2",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
