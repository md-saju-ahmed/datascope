{
  "name": "@datascope/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=../../.env dist/migrate-cli.js",
    "db:migrate:test": "node --env-file-if-exists=../../.env dist/migrate-cli.js --test",
    "db:seed": "node --env-file-if-exists=../../.env --env-file=../../.env.seed.local dist/seed/cli.js",
    "db:seed:test": "node --env-file-if-exists=../../.env --env-file=../../.env.seed.local dist/seed/cli.js --test"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
