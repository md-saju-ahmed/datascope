# Local development only. Generate an ignored .env with: pnpm env:init
NODE_ENV=development
API_HOST=127.0.0.1
PORT=4000
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=3000

POSTGRES_PORT=55431
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_ADMIN_PASSWORD
POSTGRES_APP_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_APP_PASSWORD
DATABASE_URL=postgresql://datascope_app:REPLACE_WITH_RANDOM_LOCAL_APP_PASSWORD@127.0.0.1:55431/datascope_dev

POSTGRES_TEST_PORT=55432
POSTGRES_TEST_ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_TEST_ADMIN_PASSWORD
POSTGRES_TEST_APP_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_TEST_APP_PASSWORD
DATABASE_TEST_URL=postgresql://datascope_test_app:REPLACE_WITH_DIFFERENT_RANDOM_TEST_APP_PASSWORD@127.0.0.1:55432/datascope_test
