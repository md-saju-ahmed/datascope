{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install -g pnpm@12.18.0 && pnpm install --frozen-lockfile --engine-strict=false",
  "buildCommand": "pnpm --filter @datascope/contracts build && pnpm --filter @datascope/db build && pnpm --filter @datascope/web build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
